{
	"name": "wallet-provider-spike",
	"version": "0.0.0",
	"private": true,
	"description": "Tests Turnkey and Crossmint against the machine wallet policy before Maschina depends on either.",
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"scripts": {
		"check:credentials": "node src/cli.ts ping",
		"setup:turnkey": "node src/setup-turnkey.ts",
		"check:turnkey": "node src/check-turnkey.ts",
		"setup:crossmint": "node src/setup-crossmint.ts",
		"check:crossmint": "node src/check-crossmint.ts",
		"prepare:crossmint": "node src/prepare-crossmint.ts",
		"check:recipients": "node src/check-recipients.ts",
		"time:providers": "node src/time-providers.ts",
		"check:helius": "node src/check-helius.ts",
		"test": "node --test \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@crossmint/wallets-sdk": "1.15.0",
		"@solana-program/compute-budget": "0.18.1",
		"@solana-program/memo": "0.14.0",
		"@solana-program/system": "0.14.1",
		"@solana-program/token": "0.16.1",
		"@solana/kit": "8.3.0",
		"@solana/web3.js": "1.99.0",
		"@turnkey/sdk-server": "8.5.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "24.13.5",
		"typescript": "6.0.3"
	}
}
