# Copy to .env (never committed) and fill in from each provider's dashboard.

# Turnkey: an API key pair for a user in the organisation, and the organisation id.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# Optional. Defaults to https://api.turnkey.com
TURNKEY_API_BASE_URL=

# Crossmint: a server key (starts with sk_staging_ or sk_production_). Use staging while testing.
CROSSMINT_SERVER_API_KEY=
