# Every variable the spike reads. The values live in Infisical (Development, /wallet-spike), and
# `infisical run` injects them. A local .env works too, and is never committed.

# Turnkey: an API key pair for a user in the organisation, and the organisation id.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# Optional. Defaults to https://api.turnkey.com
TURNKEY_API_BASE_URL=

# Crossmint: a server key (starts with sk_staging_ or sk_production_). Use staging while testing.
CROSSMINT_SERVER_API_KEY=

# The spike's owner: the only address a machine wallet may send SOL to. Any Solana address you control.
SPIKE_OWNER_ADDRESS=

# The non-root Turnkey user that signs for machine wallets. `pnpm setup:turnkey` creates these and saves
# them in Infisical. Don't set them by hand.
TURNKEY_SIGNER_API_PUBLIC_KEY=
TURNKEY_SIGNER_API_PRIVATE_KEY=

# The Crossmint wallet's server signer secret. `pnpm setup:crossmint` creates it and saves it in Infisical.
# Don't set it by hand.
CROSSMINT_SERVER_SIGNER_SECRET=

# The machine's scoped signer on the Crossmint wallet. `pnpm setup:crossmint` creates it and saves it in
# Infisical. Don't set it by hand.
CROSSMINT_MACHINE_SIGNER_SECRET=
