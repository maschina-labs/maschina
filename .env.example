# Copy to .env with `pnpm bootstrap`. Never commit .env.
# Every service validates its own variables on start and refuses to boot if one is wrong.

# Shared
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=

# Database (docker/docker-compose.yml)
DATABASE_URL=postgres://maschina_app:maschina_dev_password@localhost:5442/maschina
DATABASE_MIGRATION_URL=postgres://maschina_owner:maschina_dev_password@localhost:5442/maschina

# Gateway (services/gateway)
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PROVISIONER_URL=http://localhost:4400
# Seals owners' own secrets, like their AI key: openssl rand -base64 32. Never change it once set.
GATEWAY_SECRETS_KEY=
# Sending only. Unset, the contact page answers that it cannot send yet.
RESEND_API_KEY=
# Signing in with an email, Google, GitHub or a company: the secret signs a person's session (openssl rand -base64 48)
# and needs RESEND_API_KEY too. Each social provider is offered only when both its halves are set.
GATEWAY_PUBLIC_URL=http://localhost:4000
GATEWAY_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Orchestrator (services/orchestrator)
ORCHESTRATOR_PORT=4100
ORCHESTRATOR_DAEMON_TOKEN=replace-with-a-real-value
SIGNER_URL=http://localhost:4200

# Signer (services/signer). The only service that may hold wallet provider credentials.
SIGNER_PORT=4200
SIGNER_ORCHESTRATOR_TOKEN=replace-with-a-real-value

# Provisioner (services/provisioner). Makes a machine's wallet, so it holds provider credentials too.
PROVISIONER_PORT=4400
PROVISIONER_GATEWAY_TOKEN=replace-with-a-real-value

# Daemon (services/daemon)
ORCHESTRATOR_URL=http://localhost:4100
DAEMON_IDENTITY_PATH=.maschina/daemon-identity.json

# Bots (services/bots)
BOTS_PORT=4300
GATEWAY_URL=http://localhost:4000
TELEGRAM_BOT_TOKEN=

# Solana (packages/solana)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=

# The app (apps/app). Anything prefixed VITE_ is public.
VITE_GATEWAY_URL=http://localhost:4000
VITE_SENTRY_DSN=

# Front pages (apps/web). Where Sign in and Sign up go; auth.maschina.dev when unset.
VITE_AUTH_URL=http://localhost:3001
# Public by design. Set both to turn on analytics for visitors who accept optional cookies; unset, nothing is sent.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Status page heartbeats (Better Stack, Uptime, Heartbeats). Each service tells the status page it is up, from inside,
# while it is ready. One address each, because every service reads the same file. Unset, a service does not report.
GATEWAY_STATUS_HEARTBEAT_URL=
ORCHESTRATOR_STATUS_HEARTBEAT_URL=
SIGNER_STATUS_HEARTBEAT_URL=
PROVISIONER_STATUS_HEARTBEAT_URL=
BOTS_STATUS_HEARTBEAT_URL=
DAEMON_STATUS_HEARTBEAT_URL=
