# Two roles, deliberately.
#
# MASCHINA_ADMIN_URL owns the schema and is used only by `maschina db init`.
# MASCHINA_DATABASE_URL is what everything else runs as, and it holds INSERT and
# SELECT on events — no UPDATE, no DELETE. That is 02-CORE §3.5's append-only
# property enforced by the database rather than by convention.
#
# Stage 0 credentials are local-only and deliberately boring. ADR-002 covers why
# secret custody is not solved yet.

MASCHINA_ADMIN_URL=postgres://maschina:maschina@localhost:5432/maschina
MASCHINA_DATABASE_URL=postgres://maschina_app:maschina_app@localhost:5432/maschina
