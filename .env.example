# Copy to .env with `pnpm bootstrap`. Never commit .env.
# Every service validates its own variables on start and refuses to boot if one is wrong.

# Shared
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=

# Database (docker/docker-compose.yml)
DATABASE_URL=postgres://maschina_app:maschina_dev_password@localhost:5442/maschina
DATABASE_MIGRATION_URL=postgres://maschina_owner:maschina_dev_password@localhost:5442/maschina

# Gateway (services/gateway)
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGINS=http://localhost:3000
PROVISIONER_URL=http://localhost:4400

# Orchestrator (services/orchestrator)
ORCHESTRATOR_PORT=4100
ORCHESTRATOR_DAEMON_TOKEN=replace-with-a-real-value
SIGNER_URL=http://localhost:4200

# Signer (services/signer). The only service that may hold wallet provider credentials.
SIGNER_PORT=4200
SIGNER_ORCHESTRATOR_TOKEN=replace-with-a-real-value

# Provisioner (services/provisioner). Makes a machine's wallet, so it holds provider credentials too.
PROVISIONER_PORT=4400
PROVISIONER_GATEWAY_TOKEN=replace-with-a-real-value

# Daemon (services/daemon)
ORCHESTRATOR_URL=http://localhost:4100
DAEMON_IDENTITY_PATH=.maschina/daemon-identity.json

# Bots (services/bots)
BOTS_PORT=4300
GATEWAY_URL=http://localhost:4000
TELEGRAM_BOT_TOKEN=

# Solana (packages/solana)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=

# Web (apps/web). Anything prefixed VITE_ is public.
VITE_GATEWAY_URL=http://localhost:4000
VITE_SENTRY_DSN=
