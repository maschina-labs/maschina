{
	"name": "@maschina/signer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The only service allowed to request a signature from the wallet provider.",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
		"build": "tsdown",
		"start": "node --enable-source-maps dist/main.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check:bundle": "node ../../scripts/checks/bundle-deps.mjs",
		"check:turnkey": "tsx scripts/check-turnkey.ts"
	},
	"dependencies": {
		"@hono/node-server": "catalog:",
		"@maschina/contracts": "workspace:*",
		"@maschina/core": "workspace:*",
		"@maschina/db": "workspace:*",
		"@maschina/rules": "workspace:*",
		"@maschina/solana": "workspace:*",
		"@maschina/wallet": "workspace:*",
		"@sentry/node": "catalog:",
		"@turnkey/sdk-server": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"pino": "catalog:",
		"postgres": "catalog:",
		"uuidv7": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@maschina/config": "workspace:*",
		"@maschina/env": "workspace:*",
		"@maschina/service": "workspace:*",
		"@maschina/telemetry": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
