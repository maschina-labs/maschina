{
	"name": "maschina",
	"version": "0.0.10",
	"private": true,
	"description": "Software that goes to work.",
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=24.21.0 <25",
		"pnpm": ">=11.17.0 <12"
	},
	"scripts": {
		"prepare": "husky",
		"bootstrap": "node scripts/bootstrap.mjs",
		"check:machine": "node scripts/check-machine.mjs",
		"dev": "pnpm docker:up && turbo dev --filter=@maschina/web --filter=@maschina/gateway",
		"dev:all": "pnpm docker:up && turbo dev",
		"build": "turbo build check:bundle",
		"typecheck": "turbo typecheck",
		"test": "turbo test && pnpm test:scripts",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"test:spikes": "node scripts/spikes.mjs",
		"test:coverage": "turbo test:coverage",
		"test:integration": "turbo test:integration --concurrency=1",
		"check": "biome check . && pnpm check:boundaries && pnpm check:monorepo",
		"check:boundaries": "node scripts/checks/boundaries.mjs",
		"check:monorepo": "sherif",
		"check:unused": "knip",
		"check:licenses": "node scripts/checks/licenses.mjs",
		"check:secrets": "gitleaks git --redact --exit-code 1 .",
		"check:advisories": "pnpm audit --audit-level moderate && node scripts/spikes.mjs --audit",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"gate": "pnpm check && pnpm typecheck && pnpm test && pnpm test:spikes && pnpm test:integration && pnpm build",
		"db:generate": "pnpm --filter @maschina/db db:generate",
		"db:migrate": "pnpm --filter @maschina/db db:migrate",
		"db:reset": "pnpm docker:reset && pnpm db:migrate",
		"db:studio": "pnpm --filter @maschina/db db:studio",
		"docker:up": "docker compose -f docker/docker-compose.yml up -d --wait",
		"docker:down": "docker compose -f docker/docker-compose.yml down",
		"docker:reset": "docker compose -f docker/docker-compose.yml down -v && pnpm docker:up",
		"docker:services": "docker compose -f docker/docker-compose.yml --profile services up -d --build --wait",
		"ci:local": "pnpm check:secrets && pnpm check:advisories && pnpm ci:local:ci && pnpm ci:local:pr",
		"ci:local:ci": "act pull_request -W .github/workflows/ci.yml",
		"ci:local:pr": "act pull_request -W .github/workflows/pr.yml",
		"new:package": "node scripts/new-package.mjs",
		"stack": "node scripts/git/stack.mjs new",
		"restack": "node scripts/git/stack.mjs restack",
		"web": "pnpm --filter @maschina/web dev",
		"gateway": "pnpm --filter @maschina/gateway dev",
		"orchestrator": "pnpm --filter @maschina/orchestrator dev",
		"signer": "pnpm --filter @maschina/signer dev",
		"daemon": "pnpm --filter @maschina/daemon dev",
		"bots": "pnpm --filter @maschina/bots dev"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"husky": "catalog:",
		"knip": "catalog:",
		"lint-staged": "catalog:",
		"release-please": "catalog:",
		"sherif": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"yaml": "catalog:"
	}
}
