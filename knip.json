{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreWorkspaces": ["packages/config"],
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.mjs"]
		},
		"apps/web": {
			"entry": ["src/worker.ts", "scripts/*.ts"]
		},
		"apps/docs": {
			"entry": ["src/worker.ts"]
		},
		"apps/live": {
			"entry": ["src/worker.ts", "src/record.ts", "src/format.ts"]
		},
		"apps/auth": {
			"entry": ["src/worker.ts", "src/people-api.ts", "src/next.ts"]
		},
		"apps/app": {
			"entry": ["src/worker.ts", "src/dev/seed-boot.ts"]
		},
		"packages/integration-tests": {
			"entry": ["test/**/*.test.ts"]
		},
		"packages/ui": {
			"ignore": ["src/shadcn/**", "src/beautifui/**"],
			"ignoreDependencies": [
				"@base-ui/react",
				"@hookform/resolvers",
				"@shadcn/react",
				"cmdk",
				"date-fns",
				"embla-carousel-react",
				"glimm",
				"input-otp",
				"liveline",
				"next-themes",
				"react-day-picker",
				"react-hook-form",
				"react-resizable-panels",
				"recharts",
				"sonner",
				"vaul",
				"zod"
			]
		},
		"services/bots": {
			"ignoreDependencies": ["@hono/node-server", "@sentry/node", "hono", "pino", "uuidv7"]
		},
		"services/daemon": {
			"ignoreDependencies": ["@sentry/node", "pino", "uuidv7"]
		},
		"services/gateway": {
			"entry": ["api/index.ts"],
			"ignoreDependencies": [
				"@better-auth/drizzle-adapter",
				"@better-auth/sso",
				"@hono/node-server",
				"@sentry/node",
				"better-auth",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/orchestrator": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/provisioner": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"@turnkey/sdk-server",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/signer": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"@turnkey/sdk-server",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		}
	},
	"ignoreBinaries": ["act", "gitleaks", "jq"]
}
