{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreWorkspaces": ["packages/config"],
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.mjs"]
		},
		"apps/web": {
			"ignoreDependencies": ["tailwindcss"]
		},
		"packages/integration-tests": {
			"entry": ["test/**/*.test.ts"]
		},
		"services/bots": {
			"ignoreDependencies": ["@hono/node-server", "@sentry/node", "hono", "pino", "uuidv7"]
		},
		"services/daemon": {
			"ignoreDependencies": ["@sentry/node", "pino", "uuidv7"]
		},
		"services/gateway": {
			"entry": ["api/index.ts"],
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/orchestrator": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/provisioner": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"@turnkey/sdk-server",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		},
		"services/signer": {
			"ignoreDependencies": [
				"@hono/node-server",
				"@sentry/node",
				"@turnkey/sdk-server",
				"drizzle-orm",
				"pino",
				"postgres",
				"uuidv7"
			]
		}
	},
	"ignoreBinaries": ["act", "gitleaks"]
}
