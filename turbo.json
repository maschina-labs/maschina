{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": ["tsconfig.json", "packages/config/tsconfig/**"],
	"globalEnv": ["NODE_ENV", "CI"],
	"remoteCache": {
		"signature": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/test/**"],
			"outputs": ["dist/**"],
			"env": ["VITE_*", "SENTRY_*"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"test:coverage": {
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"cache": false,
			"env": ["DATABASE_URL", "DATABASE_MIGRATION_URL"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"check:bundle": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
