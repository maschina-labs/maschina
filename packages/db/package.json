{
	"name": "@maschina/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./migrate": "./src/migrator.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@maschina/core": "workspace:*",
		"@maschina/env": "workspace:*",
		"drizzle-orm": "catalog:",
		"postgres": "catalog:"
	},
	"devDependencies": {
		"@maschina/config": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"drizzle-kit": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
