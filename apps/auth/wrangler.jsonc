// How Cloudflare serves the sign in screens at auth.maschina.dev. The deploy command points at this file explicitly
// (`npx wrangler deploy --config apps/auth/wrangler.jsonc`), because run from the root of a monorepo, wrangler cannot
// tell which app it is meant to deploy.
//
// The same small Worker as the other apps sits in front of the built files, for the same reason: the licensed fonts
// live in a private bucket rather than in the repository, and it serves them from there.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "maschina-auth",
	// The sign in address. A custom domain makes this Worker its origin: Cloudflare adds the DNS record and the
	// certificate on deploy.
	"routes": [{ "pattern": "auth.maschina.dev", "custom_domain": true }],
	"compatibility_date": "2026-09-18",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The screens route in the browser, so any path that is not a file is the app's job, not a 404.
		"not_found_handling": "single-page-application",
		// The fonts are not in the build, so the Worker has to see those requests before the files do.
		"run_worker_first": ["/fonts/*"]
	},
	"r2_buckets": [{ "binding": "FONTS", "bucket_name": "maschina-fonts" }]
}
