// The old public-record hostname redirects to the company site's /live page.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "maschina-live",
	"routes": [{ "pattern": "live.maschina.dev", "custom_domain": true }],
	"compatibility_date": "2026-09-18",
	"main": "./src/worker.ts"
}
