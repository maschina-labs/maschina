# Cloudflare reads this file: the headers each address is served with.
# A reset link carries a token in its address, so nothing here sends the address on to anywhere else.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-store

# Built files carry a hash of their content in their name, so they never change under that name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
