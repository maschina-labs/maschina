		"@xterm/xterm": "^6.0.0",
		"electron": "^44.3.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"monaco-editor": "^0.56.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
